+// ── LIVE COUNTDOWN TICKER ───────────────────────────────────
+// Runs every second and re-renders each waiting customer's "Est. Mins"
+// cell by counting down from their estimated_time, instead of showing
+// a static number that only updates when the queue data changes.
+function tickEstMins() {
+  const now = Date.now();
+  document.querySelectorAll('#qItems td.est-mins').forEach(td => {
+    const target = td.dataset.target;
+    if (!target) return; // no estimated_time yet — leave the static "Xm" fallback
+    const diffMs = new Date(target).getTime() - now;
+    if (diffMs <= 0) {
+      td.innerHTML = '<span style="color:#d97706;font-weight:700;">Overdue</span>';
+    } else {
+      const mins = Math.floor(diffMs / 60000);
+      const secs = Math.floor((diffMs % 60000) / 1000);
+      td.textContent = mins + 'm ' + String(secs).padStart(2, '0') + 's';
+    }
+  });
+}
+setInterval(tickEstMins, 1000);
